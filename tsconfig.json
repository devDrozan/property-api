{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
  },
  "include": ["src", "prisma.config.ts", "prisma/seed.ts"]
}
